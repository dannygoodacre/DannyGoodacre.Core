<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>DannyGoodacre.Cqrs.Testing</PackageId>
        <Authors>Danny Goodacre</Authors>
        <Description>Testing abstractions and base classes for verifying implementations of DannyGoodacre.Cqrs.</Description>
        <RepositoryUrl>https://github.com/dannygoodacre/DannyGoodacre.Core</RepositoryUrl>
        <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
        <PackageReference Include="Moq" Version="4.20.72" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DannyGoodacre.Cqrs\DannyGoodacre.Cqrs.csproj" />
        <ProjectReference Include="..\DannyGoodacre.Testing\DannyGoodacre.Testing.csproj" />
    </ItemGroup>

    <!--
        The test contexts construct DannyGoodacre.Cqrs's internal decorators, so this package only works with the exact
        version it was built with. NuGet would otherwise declare "this version or later" for project references, which
        would let a newer DannyGoodacre.Cqrs fail at run time with MissingMethodException. The packages are versioned in
        step, so both dependencies are pinned.
    -->
    <Target Name="PinProjectReferenceVersions" AfterTargets="_GetProjectReferenceVersions">
        <ItemGroup>
            <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(ProjectVersion)]" />
        </ItemGroup>
    </Target>

</Project>
