{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=app.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Identity": {
    "InitialSuperUser": {
      "Username": "admin",
      "Password": "Password123$"
    },
    "Cookie": {
      "Name": "DannyGoodacre.Identity",
      "HttpOnly": true,
      "SecurePolicy": "Always",
      "SameSite": "Strict",
      "LoginPath": "/potatoes",
      "IsPersistent": true,
      "ExpireTimeSpan": "01:00:00",
      "SlidingExpiration": true
    },
    "PasswordValidator": {
      "RequiredLength": 8,
      "RequireNonAlphanumeric": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireDigit": true
    },
    "SecurityStamp": {
      "ValidationInterval": "00:30:00"
    }
  }
}
